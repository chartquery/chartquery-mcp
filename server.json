{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.chartquery/mcp",
  "title": "ChartQuery",
  "description": "Generate chart images, diagrams, barcodes, QR codes and thermal labels on demand. PNG, SVG or PDF o…",
  "version": "0.1.0",
  "websiteUrl": "https://www.chartquery.com",
  "repository": {
    "url": "https://github.com/chartquery/chartquery-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@chartquery/mcp",
      "version": "0.1.0",
      "environmentVariables": [
        {
          "name": "CHARTQUERY_API_KEY",
          "description": "ChartQuery API key.",
          "isRequired": true,
          "isSecret": true
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.chartquery.com/",
      "headers": [
        {
          "name": "x-api-key",
          "description": "ChartQuery API key.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
